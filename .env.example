# Copy to .env for local development. In production set these in the hosting dashboard
# (Vercel → Project → Settings → Environment Variables); nothing here is committed.

# Where the Brelo API lives.
VITE_API_BASE=https://brelo.sahl.uz

# Google Maps Platform browser key — address search in the load form (lib/places). Optional:
# without it the form falls back to OpenStreetMap. The key must list this app's domain.
VITE_GOOGLE_MAPS_KEY=
